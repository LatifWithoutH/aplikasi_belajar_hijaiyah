import 'dart:math' show sqrt, pow, cos, sin;

void main() {
  runApp(const WritingTestApp());
}

// ═══════════════════════════════════════════════════════════════
// 🎨 APP CONFIGURATION
// ═══════════════════════════════════════════════════════════════
class WritingTestApp extends StatelessWidget {
  const WritingTestApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: '🧪 Test Writing Level 3',
      theme: ThemeData(
        primarySwatch: Colors.blue,
        fontFamily: GoogleFonts.poppins().fontFamily,
        useMaterial3: true,
